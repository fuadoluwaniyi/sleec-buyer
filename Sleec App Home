  window.triggerTransferConfirm = function() {
    const proc = document.getElementById('transfer-processing-msg');
    const btnConf = document.getElementById('btn-transfer-confirm');
    const succ = document.getElementById('transfer-success-box');
    const btnDone = document.getElementById('btn-transfer-done');
    const detail = document.getElementById('transfer-success-detail');
    if (btnConf) btnConf.classList.add('hidden');
    if (proc) proc.classList.remove('hidden');
    setTimeout(() => {
      if (proc) proc.classList.add('hidden');
