<script>
(function() {
  let sleecBalance = 245680;
  let isBalanceVisible = true;
  let currentTopupAmount = 20000;
  let selectedTopupMethod = 'paystack';
  let currentWithdrawAmount = 25000;
  let selectedWithdrawBank = { name: 'GTBank', num: '•••• 4821', accName: 'Fuadino Adebayo' };

  window.formatSleecMoney = function(val) {
    return '₦' + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };

  window.refreshAllBalanceDisplays = function() {
    const balView = document.getElementById('wallet-view-balance');
    const drawerBalView = document.getElementById('drawer-menu-wallet-val');
    const withdrawAvail = document.getElementById('withdraw-avail-bal-val');
    const formatted = window.formatSleecMoney(sleecBalance);
    if (balView) {
      balView.textContent = isBalanceVisible ? formatted : '••••••••';
    }
    if (drawerBalView) {
      drawerBalView.textContent = formatted.split('.')[0];
    }
    if (withdrawAvail) {
      withdrawAvail.textContent = formatted;
    }
  };

  window.toggleWalletEye = function() {
    isBalanceVisible = !isBalanceVisible;
    const iconOpen = document.getElementById('icon-eye-open');
    const iconClosed = document.getElementById('icon-eye-closed');
    if (iconOpen && iconClosed) {
      iconOpen.classList.toggle('hidden', !isBalanceVisible);
      iconClosed.classList.toggle('hidden', isBalanceVisible);
    }
    window.refreshAllBalanceDisplays();
  };

  // Top Up Modal Handlers
  window.startTopupModal = function() {
    const modal = document.getElementById('topup-flow-modal');
    if (!modal) return;
    modal.classList.remove('translate-y-full');
    modal.classList.add('translate-y-0');
    window.showTopupStep(1);
  };

  window.closeTopupModal = function() {
    const modal = document.getElementById('topup-flow-modal');
    if (!modal) return;
    modal.classList.remove('translate-y-0');
    modal.classList.add('translate-y-full');
  };

  window.setTopupPreset = function(amt) {
    currentTopupAmount = amt;
    const input = document.getElementById('input-topup-flow-amount');
    if (input) input.value = amt;
  };

  window.showTopupStep = function(step) {
    const s1 = document.getElementById('topup-step-1');
    const s2 = document.getElementById('topup-step-2');
    const s3P = document.getElementById('topup-step-3-paystack');
    const s3C = document.getElementById('topup-step-3-card');
    const s3T = document.getElementById('topup-step-3-transfer');
    const indicator = document.getElementById('topup-step-indicator');
    const title = document.getElementById('topup-modal-title');

    [s1, s2, s3P, s3C, s3T].forEach(el => { if (el) el.classList.add('hidden'); });

    if (step === 1) {
      if (s1) s1.classList.remove('hidden');
      if (indicator) indicator.textContent = 'Step 1 of 3';
      if (title) title.textContent = 'Top Up Wallet';
    } else if (step === 2) {
      if (s2) s2.classList.remove('hidden');
      if (indicator) indicator.textContent = 'Step 2 of 3';
      if (title) title.textContent = 'Payment Method';
    } else if (step === 3) {
      if (indicator) indicator.textContent = 'Step 3 of 3';
      if (title) title.textContent = 'Confirm Payment';
      if (selectedTopupMethod === 'paystack') {
        if (s3P) s3P.classList.remove('hidden');
