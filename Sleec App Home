<script>
(function() {
  function bindHelpAndSupportInteractions() {
    const supportModal = document.getElementById('support-modal-overlay');
    const supportContent = document.getElementById('support-modal-content');
    const btnCloseSupport = document.getElementById('btn-close-support');
    const menuSupport = document.getElementById('menu-btn-support');
    const drawerOverlay = document.getElementById('buyer-drawer-overlay');
    const drawerContent = document.getElementById('buyer-drawer-content');

    function closeDrawer() {
      if (!drawerOverlay || !drawerContent) return;
      drawerOverlay.classList.remove('opacity-100', 'pointer-events-auto');
      drawerOverlay.classList.add('opacity-0', 'pointer-events-none');
      drawerContent.classList.remove('translate-x-0');
      drawerContent.classList.add('-translate-x-full');
    }

    function openSupportModal() {
      closeDrawer();
      if (!supportModal || !supportContent) return;
      supportModal.classList.remove('opacity-0', 'pointer-events-none');
      supportModal.classList.add('opacity-100', 'pointer-events-auto');
      supportContent.classList.remove('translate-y-full');
      supportContent.classList.add('translate-y-0');
    }

    function closeSupportModal() {
      if (!supportModal || !supportContent) return;
      supportModal.classList.remove('opacity-100', 'pointer-events-auto');
      supportModal.classList.add('opacity-0', 'pointer-events-none');
      supportContent.classList.remove('translate-y-0');
      supportContent.classList.add('translate-y-full');
    }

    if (menuSupport) {
      menuSupport.onclick = openSupportModal;
    }
    if (btnCloseSupport) {
      btnCloseSupport.onclick = closeSupportModal;
    }
    if (supportModal) {
      supportModal.onclick = function(e) {
        if (e.target === supportModal) closeSupportModal();
      };
    }

    // Accordion handling
    const faqToggles = document.querySelectorAll('#support-modal-content .btn-faq-toggle');
    faqToggles.forEach(btn => {
      btn.onclick = function() {
        const content = btn.parentElement.querySelector('.faq-content');
        const icon = btn.querySelector('.faq-icon');
        if (content) {
          const isHidden = content.classList.contains('hidden');
          content.classList.toggle('hidden', !isHidden);
          if (icon) icon.textContent = isHidden ? '−' : '+';
        }
      };
    });

    // Search filter
    const searchInput = document.getElementById('input-faq-search');
    if (searchInput) {
      searchInput.oninput = function(e) {
        const val = e.target.value.toLowerCase();
        const items = document.querySelectorAll('#support-modal-content .faq-item');
        items.forEach(item => {
          const text = item.textContent.toLowerCase();
          item.style.display = text.includes(val) ? '' : 'none';
        });
      };
    }

    // Toggle contact support form
    const btnToggleContact = document.getElementById('btn-toggle-contact-support');
    const contactFormContainer = document.getElementById('contact-support-form-container');
    const btnCloseContact = document.getElementById('btn-close-contact-form');
    const supportSuccess = document.getElementById('support-success-confirmation');
    const scrollContainer = document.getElementById('support-modal-scroll');

    if (btnToggleContact && contactFormContainer) {
      btnToggleContact.onclick = function() {
        contactFormContainer.classList.remove('hidden');
        if (supportSuccess) supportSuccess.classList.add('hidden');
        setTimeout(() => {
          contactFormContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 100);
      };
    }

    if (btnCloseContact && contactFormContainer) {
      btnCloseContact.onclick = function() {
        contactFormContainer.classList.add('hidden');
      };
    }

    // Contact form submit
    const form = document.getElementById('form-support-message');
    if (form) {
