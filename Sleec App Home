  // Withdraw Modal Handlers
  window.startWithdrawModal = function() {
    const modal = document.getElementById('withdraw-flow-modal');
    if (!modal) return;
    modal.classList.remove('translate-y-full');
    modal.classList.add('translate-y-0');
    window.refreshAllBalanceDisplays();
    window.showWithdrawStep(1);
  };

  window.closeWithdrawModal = function() {
    const modal = document.getElementById('withdraw-flow-modal');
    if (!modal) return;
    modal.classList.remove('translate-y-0');
    modal.classList.add('translate-y-full');
  };

  window.showWithdrawStep = function(step) {
    const s1 = document.getElementById('withdraw-step-1');
    const s2 = document.getElementById('withdraw-step-2');
    const s3 = document.getElementById('withdraw-step-3');
    const indicator = document.getElementById('withdraw-step-indicator');
    const title = document.getElementById('withdraw-modal-title');

    [s1, s2, s3].forEach(el => { if (el) el.classList.add('hidden'); });

    if (step === 1) {
      if (s1) s1.classList.remove('hidden');
      if (indicator) indicator.textContent = 'Step 1 of 3';
      if (title) title.textContent = 'Withdraw Funds';
    } else if (step === 2) {
      if (s2) s2.classList.remove('hidden');
      if (indicator) indicator.textContent = 'Step 2 of 3';
      if (title) title.textContent = 'Choose Bank Account';
    } else if (step === 3) {
      if (s3) s3.classList.remove('hidden');
      if (indicator) indicator.textContent = 'Step 3 of 3';
      if (title) title.textContent = 'Review Withdrawal';
      const amt = document.getElementById('withdraw-review-amount');
      const bnk = document.getElementById('withdraw-review-bank');
      const name = document.getElementById('withdraw-review-accname');
      const num = document.getElementById('withdraw-review-accnum');
      if (amt) amt.textContent = window.formatSleecMoney(currentWithdrawAmount);
      if (bnk) bnk.textContent = selectedWithdrawBank.name;
      if (name) name.textContent = selectedWithdrawBank.accName;
      if (num) num.textContent = selectedWithdrawBank.num;
    }
  };

  window.proceedWithdrawStep1 = function() {
    const input = document.getElementById('input-withdraw-flow-amount');
    const err = document.getElementById('withdraw-err-limit');
    const val = input ? parseFloat(input.value) : 0;
    if (isNaN(val) || val <= 0) {
      alert('Please enter a valid withdrawal amount.');
      return;
    }
    if (val > sleecBalance) {
      if (err) err.classList.remove('hidden');
      return;
    } else {
      if (err) err.classList.add('hidden');
    }
    currentWithdrawAmount = val;
    window.showWithdrawStep(2);
  };

  window.handleWithdrawBack = function() {
    const s1 = document.getElementById('withdraw-step-1');
    const s2 = document.getElementById('withdraw-step-2');
    if (s1 && !s1.classList.contains('hidden')) {
      window.closeWithdrawModal();
    } else if (s2 && !s2.classList.contains('hidden')) {
      window.showWithdrawStep(1);
    } else {
      window.showWithdrawStep(2);
    }
  };

  window.selectWithdrawBank = function(el) {
    const bankName = el.getAttribute('data-bank-name') || 'GTBank';
    const bankNum = el.getAttribute('data-bank-num') || '4821';
    selectedWithdrawBank = {
      name: bankName,
      num: '•••• ' + bankNum,
      accName: 'Fuadino Adebayo'
    };
    const allOpts = document.querySelectorAll('#saved-banks-list .bank-select-option');
    allOpts.forEach(opt => {
      opt.className = 'p-3.5 rounded-2xl border border-slate-200 bg-white cursor-pointer flex items-center justify-between transition-all hover:bg-slate-50 bank-select-option';
      const circ = opt.querySelector('.bank-radio-circle');
      const dot = opt.querySelector('.bank-radio-dot');
      if (circ) circ.className = 'w-4 h-4 rounded-full border-2 border-slate-300 flex items-center justify-center bank-radio-circle';
      if (dot) dot.className = 'w-2 h-2 rounded-full bg-transparent bank-radio-dot';
    });
    el.className = 'p-3.5 rounded-2xl border-2 border-emerald-600 bg-emerald-50/50 cursor-pointer flex items-center justify-between transition-all bank-select-option';
    const activeCirc = el.querySelector('.bank-radio-circle');
    const activeDot = el.querySelector('.bank-radio-dot');
    if (activeCirc) activeCirc.className = 'w-4 h-4 rounded-full border-2 border-emerald-600 flex items-center justify-center bank-radio-circle';
    if (activeDot) activeDot.className = 'w-2 h-2 rounded-full bg-emerald-600 bank-radio-dot';
  };

  window.toggleAddBankForm = function(force) {
    const box = document.getElementById('add-bank-form-box');
    if (!box) return;
    if (typeof force === 'boolean') {
      box.classList.toggle('hidden', !force);
    } else {
      box.classList.toggle('hidden');
    }
  };

  window.saveNewBankAccount = function() {
    const nameInput = document.getElementById('input-new-bank-name');
    const numInput = document.getElementById('input-new-bank-number');
    const accInput = document.getElementById('input-new-bank-accname');
    const bName = nameInput && nameInput.value.trim() ? nameInput.value.trim() : 'Zenith Bank';
    const bNum = numInput && numInput.value.trim() ? numInput.value.trim() : '1029384729';
    const aName = accInput && accInput.value.trim() ? accInput.value.trim() : 'Fuadino Adebayo';
    const masked = bNum.length >= 4 ? bNum.slice(-4) : '3321';

    const list = document.getElementById('saved-banks-list');
    if (list) {
      const card = document.createElement('div');
      card.className = 'p-3.5 rounded-2xl border-2 border-emerald-600 bg-emerald-50/50 cursor-pointer flex items-center justify-between transition-all bank-select-option';
      card.setAttribute('data-bank-name', bName);
      card.setAttribute('data-bank-num', masked);
      card.onclick = function() { window.selectWithdrawBank(card); };
      card.innerHTML = `<div class="flex items-center space-x-3"><div class="w-8 h-8 rounded-xl bg-white border border-emerald-200 flex items-center justify-center font-bold text-xs text-[#0c2e1f]">${bName.charAt(0).toUpperCase()}</div><div><h5 class="text-xs font-bold text-slate-900 leading-tight bank-label">${bName} •••• ${masked}</h5><p class="text-[10px] text-slate-500 mt-0.5">${aName}</p></div></div><div class="w-4 h-4 rounded-full border-2 border-emerald-600 flex items-center justify-center bank-radio-circle"><div class="w-2 h-2 rounded-full bg-emerald-600 bank-radio-dot"></div></div>`;
      
      const allOpts = document.querySelectorAll('#saved-banks-list .bank-select-option');
      allOpts.forEach(opt => {
        opt.className = 'p-3.5 rounded-2xl border border-slate-200 bg-white cursor-pointer flex items-center justify-between transition-all hover:bg-slate-50 bank-select-option';
        const circ = opt.querySelector('.bank-radio-circle');
        const dot = opt.querySelector('.bank-radio-dot');
        if (circ) circ.className = 'w-4 h-4 rounded-full border-2 border-slate-300 flex items-center justify-center bank-radio-circle';
        if (dot) dot.className = 'w-2 h-2 rounded-full bg-transparent bank-radio-dot';
      });
      list.appendChild(card);
      selectedWithdrawBank = { name: bName, num: '•••• ' + masked, accName: aName };
    }
    window.toggleAddBankForm(false);
  };

  window.proceedWithdrawStep2 = function() {
    window.showWithdrawStep(3);
  };

  window.triggerWithdrawConfirm = function() {
    const proc = document.getElementById('withdraw-processing-msg');
    const btnConf = document.getElementById('btn-withdraw-confirm');
    const succ = document.getElementById('withdraw-success-box');
    const btnDone = document.getElementById('btn-withdraw-done');
    const detail = document.getElementById('withdraw-success-detail');
    if (btnConf) btnConf.classList.add('hidden');
    if (proc) proc.classList.remove('hidden');
    setTimeout(() => {
      if (proc) proc.classList.add('hidden');
      if (succ) succ.classList.remove('hidden');
      if (detail) detail.textContent = 'Your withdrawal of ₦' + currentWithdrawAmount.toLocaleString() + ' is being processed to your bank.';
      if (btnDone) btnDone.classList.remove('hidden');
    }, 900);
  };

  window.finishWithdrawFlow = function() {
    sleecBalance -= currentWithdrawAmount;
    window.refreshAllBalanceDisplays();
    window.prependWalletTx('outflow', 'Withdrawal to ' + selectedWithdrawBank.name, currentWithdrawAmount, 'Completed');
    window.closeWithdrawModal();
    window.showWalletToast('₦' + currentWithdrawAmount.toLocaleString() + ' payout submitted successfully.');
    // reset
    const proc = document.getElementById('withdraw-processing-msg');
    const succ = document.getElementById('withdraw-success-box');
    const btnDone = document.getElementById('btn-withdraw-done');
    const btnConf = document.getElementById('btn-withdraw-confirm');
    if (proc) proc.classList.add('hidden');
    if (succ) succ.classList.add('hidden');
    if (btnDone) btnDone.classList.add('hidden');
    if (btnConf) btnConf.classList.remove('hidden');
  };

  window.prependWalletTx = function(type, title, amt, status) {
    const list = document.getElementById('wallet-tx-list');
    if (!list) return;
    const row = document.createElement('div');
    row.className = 'flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100 wallet-tx-item';
    row.setAttribute('data-tx-type', type);
    const isPlus = type === 'inflow';
    row.innerHTML = `<div class="flex items-center space-x-3"><div class="w-8 h-8 rounded-full ${isPlus ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'} flex items-center justify-center font-bold text-xs flex-shrink-0">${isPlus ? '↓' : '↑'}</div><div><div class="flex items-center gap-1.5"><h5 class="text-xs font-bold text-slate-900 leading-tight">${title}</h5><span class="px-1.5 py-0.5 text-[9px] font-semibold ${isPlus ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'} rounded-full">${status || 'Completed'}</span></div><p class="text-[10px] text-slate-400 mt-0.5">Just now</p></div></div><span class="text-xs font-bold ${isPlus ? 'text-emerald-700' : 'text-rose-600'}">${isPlus ? '+' : '-'}₦${amt.toLocaleString()}</span>`;
    list.insertBefore(row, list.firstChild);
  };

  window.filterWalletTx = function(category) {
    const btnAll = document.getElementById('wallet-filter-all');
    const btnIn = document.getElementById('wallet-filter-inflow');
    const btnOut = document.getElementById('wallet-filter-outflow');
    [btnAll, btnIn, btnOut].forEach(btn => {
      if (!btn) return;
      btn.className = 'px-3 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 flex-shrink-0 transition-colors';
    });
    if (category === 'all' && btnAll) {
      btnAll.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-[#0c2e1f] text-white flex-shrink-0 transition-colors';
    } else if (category === 'inflow' && btnIn) {
      btnIn.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-[#0c2e1f] text-white flex-shrink-0 transition-colors';
    } else if (category === 'outflow' && btnOut) {
      btnOut.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-[#0c2e1f] text-white flex-shrink-0 transition-colors';
    }
    const rows = document.querySelectorAll('#wallet-tx-list .wallet-tx-item');
    rows.forEach(r => {
      const t = r.getAttribute('data-tx-type');
      if (category === 'all' || t === category) {
        r.style.display = '';
      } else {
        r.style.display = 'none';
      }
    });
  };

  window.showWalletToast = function(msg) {
    const banner = document.getElementById('wallet-alert-banner');
    const label = document.getElementById('wallet-alert-msg');
    if (banner && label) {
      label.textContent = msg;
      banner.classList.remove('hidden');
      setTimeout(() => {
        banner.classList.add('hidden');
      }, 3500);
    }
  };

  window.openSleecWallet = function() {
    const overlay = document.getElementById('wallet-modal-overlay');
    const sheet = document.getElementById('wallet-modal-content');
    if (overlay && sheet) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      sheet.classList.remove('translate-y-full');
      sheet.classList.add('translate-y-0');
    }
  };

  window.closeSleecWallet = function() {
    const overlay = document.getElementById('wallet-modal-overlay');
    const sheet = document.getElementById('wallet-modal-content');
    if (overlay && sheet) {
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      sheet.classList.remove('translate-y-0');
      sheet.classList.add('translate-y-full');
    }
  };

  window.refreshAllBalanceDisplays();
})();
