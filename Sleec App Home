  };

  window.triggerCardPay = function() {
    const proc = document.getElementById('card-processing-msg');
    const btnPay = document.getElementById('btn-card-pay');
    const succ = document.getElementById('card-success-box');
    const btnDone = document.getElementById('btn-card-done');
    const detail = document.getElementById('card-success-detail');
    if (btnPay) btnPay.classList.add('hidden');
    if (proc) proc.classList.remove('hidden');
    setTimeout(() => {
      if (proc) proc.classList.add('hidden');
      if (succ) succ.classList.remove('hidden');
      if (detail) detail.textContent = '₦' + currentTopupAmount.toLocaleString() + ' has been credited to your balance.';
      if (btnDone) btnDone.classList.remove('hidden');
    }, 900);
  };

  window.copyAccountNumber = function() {
    const feedback = document.getElementById('copy-feedback');
    if (feedback) {
      feedback.classList.remove('hidden');
      setTimeout(() => feedback.classList.add('hidden'), 2500);
