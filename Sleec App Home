<style data-purpose="custom-layout">
    /* iOS frame setup & smooth scrolling */
    body {
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }
    /* Hide scrollbar for clean app feel */
    ::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    /* Smooth background crossfade animations */
    .hero-slide {
      transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1), transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .hero-slide.inactive {
      opacity: 0;
      transform: scale(1.05);
      pointer-events: none;
    }
    .hero-slide.active {
      opacity: 1;
      transform: scale(1);
      pointer-events: auto;
    }

    /* Organic slow, elegant decelerating transitions for mini product cards */
    .product-track {
      transition: transform 2200ms cubic-bezier(0.25, 1, 0.5, 1);
      will-change: transform;
    }

    /* Subtle parallax, scale cushion, and soft depth fade during swipe transitions */
    .product-item {
      transition: transform 2200ms cubic-bezier(0.25, 1, 0.5, 1), opacity 1800ms cubic-bezier(0.25, 1, 0.5, 1);
      will-change: transform, opacity;
    }
    .product-item img {
      transition: transform 2400ms cubic-bezier(0.25, 1, 0.5, 1), filter 1800ms ease;
    }
    .product-item .item-meta {
      transition: transform 2000ms cubic-bezier(0.25, 1, 0.5, 1), opacity 1600ms ease;
    }

    /* Active & inactive slide states inside mini cards */
    .product-item.item-active {
      opacity: 1;
      transform: scale(1);
    }
    .product-item.item-active img {
      transform: scale(1);
      filter: blur(0px);
    }
    .product-item.item-active .item-meta {
      transform: translateY(0);
      opacity: 1;
    }

    .product-item.item-inactive {
      opacity: 0.65;
      transform: scale(0.96);
    }
    .product-item.item-inactive img {
      transform: scale(1.08);
      filter: blur(0.4px);
    }
    .product-item.item-inactive .item-meta {
      transform: translateY(6px);
      opacity: 0.4;
    }

    /* Multi-state interactive container smooth transition */
    .dynamic-state {
      transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1), transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .dynamic-state.hidden-state {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
      pointer-events: none;
      position: absolute;
      inset: 0;
    }
    .dynamic-state.active-state {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
      position: relative;
    }
  </style>
