<script>
window.selectedPdpSize = '42';
window.selectedPdpQty = 1;
window.sleecCartCount = 3;
const unitPrice = 32000;

function showPdpToast(msg) {
  const toast = document.getElementById('pdp-toast');
  if (!toast) return;
  toast.textContent = msg;
  toast.classList.remove('opacity-0', 'pointer-events-none');
  toast.classList.add('opacity-100');
  clearTimeout(window._pdpToastTimer);
  window._pdpToastTimer = setTimeout(() => {
    toast.classList.remove('opacity-100');
    toast.classList.add('opacity-0', 'pointer-events-none');
  }, 2200);
}

function switchGalleryThumb(btn, imgUrl) {
  const img = document.getElementById('main-product-display-img');
  if (img) img.src = imgUrl;
  document.querySelectorAll('#gallery-thumbs-row .thumb-btn').forEach(b => {
    b.className = 'thumb-btn w-14 h-14 rounded-2xl overflow-hidden flex-shrink-0 shadow-sm opacity-60 hover:opacity-100 scale-95 transition-all';
  });
  btn.className = 'thumb-btn w-14 h-14 rounded-2xl overflow-hidden flex-shrink-0 shadow-md scale-100 opacity-100 transition-all';
}

function handleSizeSelect(btn, size) {
  window.selectedPdpSize = size;
  document.querySelectorAll('.size-choice-btn').forEach(b => {
    b.className = 'size-choice-btn py-2.5 rounded-xl bg-slate-50 text-slate-700 text-xs font-medium shadow-sm hover:bg-slate-100 transition-all active:scale-95';
  });
  btn.className = 'size-choice-btn py-2.5 rounded-xl bg-emerald-50 text-emerald-800 text-xs font-bold shadow-sm transition-all active:scale-95';
}

function changePdpQty(delta) {
  const el = document.getElementById('pdp-qty');
  if (!el) return;
  let current = parseInt(el.textContent) || 1;
  current = Math.max(1, Math.min(14, current + delta));
  window.selectedPdpQty = current;
  el.textContent = current;
  const priceEl = document.getElementById('display-price');
  if (priceEl) {
    priceEl.textContent = '₦' + (current * unitPrice).toLocaleString();
  }
}

function openSizeGuideModal() {
  const modal = document.getElementById('size-guide-modal');
  const content = document.getElementById('size-guide-modal-content');
  if (!modal) return;
  modal.classList.remove('opacity-0', 'pointer-events-none');
  modal.classList.add('opacity-100');
  if (content) {
    content.classList.remove('translate-y-8');
    content.classList.add('translate-y-0');
  }
}

function closeSizeGuideModal() {
  const modal = document.getElementById('size-guide-modal');
  const content = document.getElementById('size-guide-modal-content');
  if (!modal) return;
  modal.classList.remove('opacity-100');
  modal.classList.add('opacity-0', 'pointer-events-none');
  if (content) {
    content.classList.remove('translate-y-0');
    content.classList.add('translate-y-8');
  }
}

function showStoreModal() {
  const modal = document.getElementById('store-info-modal');
  const content = document.getElementById('store-info-modal-content');
  if (!modal) return;
  modal.classList.remove('opacity-0', 'pointer-events-none');
  modal.classList.add('opacity-100');
  if (content) {
    content.classList.remove('scale-95');
    content.classList.add('scale-100');
  }
}

function closeStoreModal() {
  const modal = document.getElementById('store-info-modal');
  const content = document.getElementById('store-info-modal-content');
  if (!modal) return;
  modal.classList.remove('opacity-100');
  modal.classList.add('opacity-0', 'pointer-events-none');
  if (content) {
    content.classList.remove('scale-100');
    content.classList.add('scale-95');
  }
}

function openStorefrontFromModal(storeId) {
  closeStoreModal();
  setTimeout(() => {
    openStorefrontView(storeId);
  }, 180);
}

function openStorefrontView(storeId) {
  const sfView = document.getElementById('storefront-view');
  if (!sfView) return;
  sfView.classList.remove('hidden');
  setTimeout(() => {
    sfView.classList.remove('opacity-0', 'translate-y-4');
    sfView.classList.add('opacity-100', 'translate-y-0');
    sfView.scrollTo({top: 0, behavior: 'instant'});
  }, 10);
}

function closeStorefrontView() {
  const sfView = document.getElementById('storefront-view');
  if (!sfView) return;
  sfView.classList.remove('opacity-100', 'translate-y-0');
  sfView.classList.add('opacity-0', 'translate-y-4');
  setTimeout(() => {
    sfView.classList.add('hidden');
  }, 300);
}

function shareStoreAction() {
  if (navigator.share) {
    navigator.share({title: 'Sage & Co. Storefront on Sleec', url: window.location.href}).catch(() => {});
  } else if (navigator.clipboard) {
    navigator.clipboard.writeText(window.location.href);
    showPdpToast('Store link copied to clipboard!');
  } else {
    showPdpToast('Store link copied!');
  }
}

function toggleStoreFollow(btn) {
  if (btn.textContent.includes('Follow Store')) {
    btn.textContent = 'Following ✓';
    btn.className = 'mb-1 px-4 py-2 rounded-2xl bg-slate-100 text-[#0c2e1f] text-xs font-bold shadow-sm transition-all active:scale-95';
    showPdpToast('You are now following Sage & Co.');
  } else {
    btn.textContent = 'Follow Store';
    btn.className = 'mb-1 px-4 py-2 rounded-2xl bg-[#0c2e1f] text-white text-xs font-bold shadow-sm hover:bg-[#072418] transition-all active:scale-95';
    showPdpToast('Unfollowed Sage & Co.');
  }
}

function selectStoreCategory(btn, category) {
  document.querySelectorAll('#store-category-pills .sf-cat-pill').forEach(p => {
    p.className = 'sf-cat-pill px-4 py-2 rounded-2xl bg-white text-slate-700 text-xs font-medium shadow-sm whitespace-nowrap hover:bg-slate-50 transition-all';
  });
  btn.className = 'sf-cat-pill px-4 py-2 rounded-2xl bg-[#0c2e1f] text-white text-xs font-bold shadow-sm whitespace-nowrap transition-all';

  const cards = document.querySelectorAll('.sf-product-card');
  let visibleCount = 0;
  cards.forEach(card => {
    const cardCat = card.getAttribute('data-category');
    if (category === 'all' || cardCat === category) {
      card.style.display = 'flex';
      visibleCount++;
    } else {
      card.style.display = 'none';
    }
  });
  const countEl = document.getElementById('store-product-count');
  if (countEl) countEl.textContent = visibleCount + ' Items';
}

function filterStoreCatalog(query) {
  const q = query.toLowerCase().trim();
  const cards = document.querySelectorAll('.sf-product-card');
  let visibleCount = 0;
  cards.forEach(card => {
    const name = (card.getAttribute('data-name') || '').toLowerCase();
    if (!q || name.includes(q)) {
      card.style.display = 'flex';
      visibleCount++;
    } else {
      card.style.display = 'none';
    }
  });
  const countEl = document.getElementById('store-product-count');
  if (countEl) countEl.textContent = visibleCount + ' Items';
}

function sortStoreCatalog(criteria) {
  const grid = document.getElementById('store-products-grid');
  if (!grid) return;
  const cards = Array.from(grid.querySelectorAll('.sf-product-card'));
  if (criteria === 'low-to-high') {
    cards.sort((a, b) => parseInt(a.getAttribute('data-price')) - parseInt(b.getAttribute('data-price')));
  } else if (criteria === 'high-to-low') {
    cards.sort((a, b) => parseInt(b.getAttribute('data-price')) - parseInt(a.getAttribute('data-price')));
  }
  cards.forEach(card => grid.appendChild(card));
}

function toggleSfWishlist(btn) {
  const isSaved = btn.classList.toggle('text-rose-500');
  if (isSaved) {
    btn.classList.remove('text-slate-400');
    showPdpToast('Added to wishlist');
  } else {
    btn.classList.add('text-slate-400');
    showPdpToast('Removed from wishlist');
  }
}

function addStoreItemToBag(productName, price) {
  window.sleecCartCount = (window.sleecCartCount || 3) + 1;
  const badge = document.getElementById('sf-cart-badge');
  if (badge) badge.textContent = window.sleecCartCount;
  showPdpToast('Added ' + productName + ' to Bag');
}

function toggleStoreAboutAccordion() {
  const content = document.getElementById('sf-about-content');
  const arrow = document.getElementById('sf-about-arrow');
  if (!content) return;
  if (content.classList.contains('hidden')) {
    content.classList.remove('hidden');
    if (arrow) arrow.classList.add('rotate-180');
  } else {
    content.classList.add('hidden');
    if (arrow) arrow.classList.remove('rotate-180');
  }
}

function handleAddToBag() {
  const size = window.selectedPdpSize || '42';
  const qty = window.selectedPdpQty || 1;
  window.sleecCartCount = (window.sleecCartCount || 3) + qty;
  const badge = document.getElementById('sf-cart-badge');
  if (badge) badge.textContent = window.sleecCartCount;

  if (window.sleecState && Array.isArray(window.sleecState.cart)) {
    const existing = window.sleecState.cart.find(item => item.id === 'stride-sage' && item.size === size);
    if (existing) {
      existing.qty += qty;
    } else {
      window.sleecState.cart.push({
        id: 'stride-sage',
        name: 'Stride Club Sage Runners',
        variant: 'Size ' + size,
        size: size,
        store: 'Sage & Co.',
        price: unitPrice,
        qty: qty,
        image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAwdxrWHwVDyPOIKfXj9lMJWDVhtYv9u0JCRKfAa1qGoXuHqGrY8vqyOmybJYNbP2mxYMGsV51I-GeK6mg7HfLHFunccdY-xa5hRyLhocK2rTEPilPpWH0Cc-m3PvgslWJoVof5vCbwQj3SlQcumwCKLW3y6w0dcfCkgB2oKPzlUXbZKVuACHPrWxwHS2FdcQf1WNtr3afEafqyp-qdHhuUf2MMYMIwcz6tnwbtmahPRrn-6VZ1viZZJ8XWA5zrZ6Av'
      });
    }
    if (typeof window.renderCartBagUI === 'function') window.renderCartBagUI();
  }
  showPdpToast('Added ' + qty + ' Stride Club Sage Runners (Size ' + size + ') to Bag');
}

function handleBuyNow() {
  const size = window.selectedPdpSize || '42';
  const qty = window.selectedPdpQty || 1;
  const total = (qty * unitPrice).toLocaleString();
  showPdpToast('Proceeding to Checkout: ₦' + total + ' (Size ' + size + ')');
}
</script></div>
