              </div>
            </div>
          </div>
        </div>
      </div>
    `).join('');
  };

  // Cart Mutators
  window.changeItemQty = function(id, delta) {
    const item = window.sleecState.cart.find(i => i.id === id);
    if (!item) return;
    item.qty += delta;
    if (item.qty <= 0) {
      window.sleecState.cart = window.sleecState.cart.filter(i => i.id !== id);
    }
    window.renderCartBagUI();
  };

  window.removeCartItem = function(id) {
    window.sleecState.cart = window.sleecState.cart.filter(i => i.id !== id);
