      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.style.cssText = 'display: none !important;';
      }, 200);
    }
  };

  window.selectBuyerAddress = function(tag, namePhone, details) {
    window.sleecState.deliveryAddress = { tag, namePhone, details };
    window.closeAddressPickerModal();
    window.renderCheckoutStep();
  };

  window.saveAndApplyNewAddress = function() {
    const name = document.getElementById('in-new-name').value.trim();
    const phone = document.getElementById('in-new-phone').value.trim();
    const street = document.getElementById('in-new-street').value.trim();
    const city = document.getElementById('in-new-city').value.trim();
    const state = document.getElementById('in-new-state').value.trim();

    if (!street || !city) {
      alert('Please fill out street and city fields.');
      return;
    }
    const fullDetails = `${street}, ${city}${state ? ', ' + state : ''}`;
    window.selectBuyerAddress('CUSTOM', `${name || 'Fuadino Adebayo'} • ${phone || '+234 812 345 6789'}`, fullDetails);
    document.getElementById('add-new-address-inline-form').classList.add('hidden');
  };

  // 9. PAYMENT SIMULATION PROCESSOR
  window.executePaymentSimulation = function() {
    if (window.sleecState.isProcessingPayment) return;
    window.sleecState.isProcessingPayment = true;

    const btnNext = document.getElementById('btn-checkout-next');
    if (btnNext) {
      btnNext.disabled = true;
      btnNext.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        Authorizing Payment...
      `;
    }

    setTimeout(() => {
      window.sleecState.isProcessingPayment = false;
      window.sleecState.checkoutStep = 4;
      window.renderCheckoutStep();
    }, 1100);
  };

  // 10. RECEIPT MODAL
  window.openReceiptModal = function() {
    const modal = document.getElementById('receipt-modal');
    const orderEl = document.getElementById('rcpt-order-id');
    const payEl = document.getElementById('rcpt-payment-type');
    const fulEl = document.getElementById('rcpt-fulfilment-type');
    const totEl = document.getElementById('rcpt-total-paid');
    const itemsEl = document.getElementById('receipt-items-breakdown');

    const { total } = window.getCartTotals();
    const isPickup = window.sleecState.fulfilment === 'pickup';

    if (orderEl) orderEl.textContent = window.sleecState.orderId;
    if (payEl) {
      payEl.textContent = window.sleecState.paymentMethod === 'wallet' ? 'Sleec Pay Wallet' : (window.sleecState.paymentMethod === 'card' ? 'Debit Card' : 'Bank Transfer');
    }
    if (fulEl) {
      fulEl.textContent = isPickup ? `Pickup: ${window.sleecState.pickupStore.name}` : `Delivery: ${window.sleecState.deliveryAddress.details}`;
    }
    if (totEl) totEl.textContent = '₦' + total.toLocaleString();

    if (itemsEl) {
      itemsEl.innerHTML = window.sleecState.cart.map(i => `
        <div class="flex justify-between">
          <span class="truncate max-w-[190px] text-slate-700">${i.name} (x${i.qty})</span>
          <span class="font-bold text-slate-900">₦${(i.price * i.qty).toLocaleString()}</span>
        </div>
      `).join('');
    }

    if (modal) {
      modal.style.cssText = '';
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
      }, 10);
    }
  };

  window.closeReceiptModal = function() {
    const modal = document.getElementById('receipt-modal');
    if (modal) {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.style.cssText = 'display: none !important;';
      }, 200);
    }
  };

  window.printReceipt = function() {
    window.print ? window.print() : alert('Receipt printed successfully');
  };

  // 11. COMPLETE CHECKOUT AND RETURN TO CLEAN HOMEPAGE
  window.finishAndContinueShopping = function() {
    window.closeReceiptModal();
    window.sleecState.cart = [];
    window.sleecState.checkoutStep = 1;
    window.closeSleecCheckout();
    window.renderCartBagUI();
  };

  // Automated Hero Carousel background switching
  let currentHeroSlide = 3;
  setInterval(() => {
    const slides = [0, 1, 2, 3];
    currentHeroSlide = (currentHeroSlide + 1) % slides.length;
    slides.forEach(idx => {
      const slide = document.getElementById('hero-slide-' + idx);
      const dot = document.querySelector(`.hero-dot[data-slide="${idx}"]`);
      if (slide) {
        if (idx === currentHeroSlide) {
          slide.classList.remove('inactive');
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
          slide.classList.add('inactive');
        }
      }
      if (dot) {
        if (idx === currentHeroSlide) {
          dot.className = 'hero-dot w-4 h-1.5 rounded-full bg-white transition-all duration-300';
        } else {
          dot.className = 'hero-dot w-1.5 h-1.5 rounded-full bg-white/40 transition-all duration-300';
        }
      }
    });
  }, 4500);

  // Initial State Setup
  window.renderCartBagUI();
})();
</script>
</div>
<!-- END: PhoneShellContainer -->


