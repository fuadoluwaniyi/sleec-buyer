    const discRow = document.getElementById('sleec-bag-discount-row');
    const discEl = document.getElementById('sleec-bag-discount');
    const checkoutBtn = document.getElementById('btn-cart-checkout-pay');

    const { subtotal, discount, total, totalItemCount } = window.getCartTotals();

    // Top badge sync
    if (badge) {
      badge.textContent = totalItemCount;
      badge.style.display = totalItemCount > 0 ? 'flex' : 'none';
    }
    if (headerCount) headerCount.textContent = totalItemCount;
    if (subtotalEl) subtotalEl.textContent = '₦' + subtotal.toLocaleString();
    if (totalEl) totalEl.textContent = '₦' + total.toLocaleString();

    if (discount > 0 && discRow && discEl) {
      discRow.classList.remove('hidden');
      discEl.textContent = '-₦' + discount.toLocaleString();
    } else if (discRow) {
      discRow.classList.add('hidden');
    }

    if (!container) return;

    if (window.sleecState.cart.length === 0) {
      container.innerHTML = `
        <div class="p-8 text-center text-slate-400 space-y-2">
          <div class="text-3xl">🛍️</div>
          <p class="text-xs font-semibold text-slate-600">Your bag is empty</p>
          <p class="text-[11px]">Discover fresh fashion and luxury scent drops on the homepage.</p>
        </div>
      `;
      if (checkoutBtn) {
        checkoutBtn.disabled = true;
        checkoutBtn.classList.add('opacity-50', 'pointer-events-none');
      }
      return;
    }

    if (checkoutBtn) {
      checkoutBtn.disabled = false;
      checkoutBtn.classList.remove('opacity-50', 'pointer-events-none');
    }

    container.innerHTML = window.sleecState.cart.map(item => `
      <div class="p-3 rounded-2xl bg-white shadow-sm border border-slate-100 flex items-center justify-between gap-3 cart-item-row" data-id="${item.id}">
        <div class="flex items-center gap-3 min-w-0 flex-1">
