  // 1. Calculations Helper
  window.getCartTotals = function() {
    const subtotal = window.sleecState.cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
    const discount = Math.round(subtotal * (window.sleecState.discountPercent / 100));
    let fee = 0;
    if (window.sleecState.fulfilment === 'courier') fee = 2000;
    if (window.sleecState.fulfilment === 'seller') fee = 3500;
    const total = Math.max(0, subtotal - discount) + fee;
    const totalItemCount = window.sleecState.cart.reduce((count, item) => count + item.qty, 0);

    return { subtotal, discount, fee, total, totalItemCount };
  };

  // 2. Bag UI Render
  window.renderCartBagUI = function() {
    const container = document.getElementById('sleec-bag-items-container');
    const badge = document.getElementById('top-cart-badge');
    const headerCount = document.getElementById('sleec-bag-item-count');
    const subtotalEl = document.getElementById('sleec-bag-subtotal');
