<script data-purpose="interactive-habit-toggles">
    function initAnimations() {
      // Background Hero Carousel crossfade logic for all 4 slides
      const slides = [
        document.getElementById('hero-slide-0'),
        document.getElementById('hero-slide-1'),
        document.getElementById('hero-slide-2'),
        document.getElementById('hero-slide-3')
      ];
      const dots = document.querySelectorAll('.hero-dot');
      let currentHeroIdx = 0;

      function switchHeroSlide(targetIdx) {
        currentHeroIdx = (targetIdx + slides.length) % slides.length;
        slides.forEach((slide, idx) => {
          if (!slide) return;
          if (idx === currentHeroIdx) {
            slide.classList.remove('inactive');
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
            slide.classList.add('inactive');
          }
        });
        dots.forEach((dot, idx) => {
          if (idx === currentHeroIdx) {
            dot.className = "hero-dot w-4 h-1.5 rounded-full bg-white transition-all duration-300";
          } else {
            dot.className = "hero-dot w-1.5 h-1.5 rounded-full bg-white/40 transition-all duration-300";
          }
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-slide') || '0', 10);
          switchHeroSlide(idx);
          resetHeroInterval();
        });
      });

      let heroInterval = setInterval(() => {
        switchHeroSlide(currentHeroIdx + 1);
      }, 5500);

      function resetHeroInterval() {
        clearInterval(heroInterval);
        heroInterval = setInterval(() => {
          switchHeroSlide(currentHeroIdx + 1);
        }, 5500);
      }

      // Dynamic Card Swipe Logic with relaxed 6.0s interval
      const track1 = document.getElementById('track-box-1');
      const track2 = document.getElementById('track-box-2');
      const track3 = document.getElementById('track-box-3');

      const c1Item0 = document.getElementById('card-1-item-0');
      const c1Item1 = document.getElementById('card-1-item-1');
      const c2Item0 = document.getElementById('card-2-item-0');
      const c2Item1 = document.getElementById('card-2-item-1');
      const c3Item0 = document.getElementById('card-3-item-0');
      const c3Item1 = document.getElementById('card-3-item-1');

      let cardStep = 0;

      function executeOrganicSwipe() {
        cardStep = (cardStep + 1) % 2;

        setTimeout(() => {
          if (track1) {
            track1.style.transform = cardStep === 1 ? 'translateY(-50%)' : 'translateY(0%)';
            if (c1Item0 && c1Item1) {
              c1Item0.classList.toggle('item-active', cardStep === 0);
              c1Item0.classList.toggle('item-inactive', cardStep === 1);
              c1Item1.classList.toggle('item-active', cardStep === 1);
              c1Item1.classList.toggle('item-inactive', cardStep === 0);
            }
          }
        }, 0);

        setTimeout(() => {
          if (track2) {
            track2.style.transform = cardStep === 1 ? 'translateY(0%)' : 'translateY(-50%)';
            if (c2Item0 && c2Item1) {
              c2Item0.classList.toggle('item-active', cardStep === 1);
              c2Item0.classList.toggle('item-inactive', cardStep === 0);
              c2Item1.classList.toggle('item-active', cardStep === 0);
              c2Item1.classList.toggle('item-inactive', cardStep === 1);
            }
          }
        }, 160);

        setTimeout(() => {
          if (track3) {
            track3.style.transform = cardStep === 1 ? 'translateY(-50%)' : 'translateY(0%)';
            if (c3Item0 && c3Item1) {
              c3Item0.classList.toggle('item-active', cardStep === 0);
              c3Item0.classList.toggle('item-inactive', cardStep === 1);
              c3Item1.classList.toggle('item-active', cardStep === 1);
              c3Item1.classList.toggle('item-inactive', cardStep === 0);
            }
          }
        }, 320);
      }

      setInterval(executeOrganicSwipe, 6000);

      // Multi-State Box Controller (State 1: Your first find awaits -> State 2: Delivery progress -> State 3: Find more on Sleec)
      const stateScreens = [
        document.getElementById('state-screen-0'),
        document.getElementById('state-screen-1'),
        document.getElementById('state-screen-2')
      ];
      const multiDots = document.querySelectorAll('.multi-dot');
      const multiBox = document.getElementById('multi-state-box');
      let currentBoxState = 0;
      let multiStateTimer = null;

      function setBoxState(stateIdx) {
        currentBoxState = stateIdx % stateScreens.length;
        stateScreens.forEach((scr, idx) => {
          if (!scr) return;
          if (idx === currentBoxState) {
            scr.classList.remove('hidden-state');
            scr.classList.add('active-state');
          } else {
            scr.classList.remove('active-state');
            scr.classList.add('hidden-state');
          }
        });

        // Update container theme styling slightly between dark state 2 and light states 1 & 3
        if (multiBox) {
          if (currentBoxState === 1) {
            multiBox.className = "my-3.5 relative overflow-hidden rounded-[26px] bg-[#0c2e1f] border border-emerald-700/50 shadow-xl h-[132px] min-h-[132px] max-h-[132px] flex items-center transition-all duration-500";
          } else {
            multiBox.className = "my-3.5 relative overflow-hidden rounded-[26px] bg-[#eef6ed] border border-emerald-900/10 shadow-lg h-[132px] min-h-[132px] max-h-[132px] flex items-center transition-all duration-500";
          }
        }

        // Update dot indicators
        multiDots.forEach((dot, idx) => {
          if (idx === currentBoxState) {
            dot.className = currentBoxState === 1 ? "multi-dot w-3.5 h-1.5 rounded-full bg-emerald-400 transition-all" : "multi-dot w-3.5 h-1.5 rounded-full bg-emerald-800 transition-all";
          } else {
            dot.className = currentBoxState === 1 ? "multi-dot w-1.5 h-1.5 rounded-full bg-white/40 transition-all" : "multi-dot w-1.5 h-1.5 rounded-full bg-emerald-800/30 transition-all";
          }
        });
      }

      // Action button triggers
      const btnExplore = document.getElementById('btn-explore-products');
      if (btnExplore) {
        btnExplore.addEventListener('click', (e) => {
          e.stopPropagation();
          setBoxState(1); // Jump to State 2 (Delivery progress)
          restartStateTimer();
        });
      }

      const btnExploreSleec = document.getElementById('btn-explore-sleec');
      if (btnExploreSleec) {
        btnExploreSleec.addEventListener('click', (e) => {
          e.stopPropagation();
          setBoxState(0); // Cycle back to State 1
          restartStateTimer();
        });
      }

      multiDots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          const target = parseInt(dot.getAttribute('data-target-state') || '0', 10);
          setBoxState(target);
          restartStateTimer();
        });
      });

      function restartStateTimer() {
        if (multiStateTimer) clearInterval(multiStateTimer);
        // Automatic state advance every 30 seconds as requested
        multiStateTimer = setInterval(() => {
          setBoxState((currentBoxState + 1) % 3);
        }, 30000);
      }

      restartStateTimer();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAnimations);
    } else {
      initAnimations();
    }
  </script>
