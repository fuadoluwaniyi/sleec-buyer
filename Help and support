  if (btnChangeAvatar && previewAvatar) {
    const avatarUrls = [
      'https://lh3.googleusercontent.com/aida-public/AB6AXuBf2KosHaPce84SUSv-V8EHDvhcU9R7IaflLN1tk5BGVfRfl54Z2o3EXqPDGQsENPT5K-ueIAzsfOOee1h4FZxqMTdpTd1RNP4_kpEl8ldWzTotR89Yp1vzSXIVCb8iUsR1alOuPPsbAkwCJp8jJBhcxfZc7w0P13Gx-hQUkOeDS7bLgMtwVcxfpBN-ROfOvrKR-mTxX7xx7VXVJ59a334zEpt2oR8f3uThXvkeTfqETtacZkftJUo-w6z1krWN6Bhp',
      'https://lh3.googleusercontent.com/aida-public/AB6AXuC9d94DYr4PG1QgN7xx4JfeTZ6ltuUb8I2KM7IsyrBXzi25PymzKJQPQZ6Xz7oHKfpL-kmb9ZtElCMYJEKO3gew8PQKkhyGK24b7jeFTXw1oTkm-VsFm1BU-NkXWN7tdBXid7ZoP8MAarsrPafitfO2K9aQC69oRXdXit55oWLGdYoPl3laGnHSIQ43g1j9v3edzjl-17ZIov7d4iXFeXf73gJJJSN9eCEi6xppBczaRICfxRnE2wrHpzJ5abJo9aOX'
    ];
    let currAvIdx = 0;
    btnChangeAvatar.addEventListener('click', () => {
      currAvIdx = (currAvIdx + 1) % avatarUrls.length;
      previewAvatar.src = avatarUrls[currAvIdx];
      if (drawerAvatar) drawerAvatar.src = avatarUrls[currAvIdx];
    });
  }

  if (btnSaveProfile) {
    btnSaveProfile.addEventListener('click', () => {
      if (inputProfileName && inputProfileName.value.trim()) {
        currentUser.name = inputProfileName.value.trim();
      }
      if (inputProfileEmail && inputProfileEmail.value.trim()) {
        currentUser.email = inputProfileEmail.value.trim();
      }
      if (inputProfilePhone) currentUser.phone = inputProfilePhone.value.trim();
      if (inputProfileBio) currentUser.bio = inputProfileBio.value.trim();

      // Reflect dynamically
      if (drawerDisplayName) drawerDisplayName.textContent = currentUser.name;
      if (drawerDisplayEmail) drawerDisplayEmail.textContent = currentUser.email;
      if (greetingTitle) {
        const firstName = currentUser.name.split(' ')[0] || currentUser.name;
        greetingTitle.textContent = 'Hey, ' + firstName;
      }
      hideModal(profileModal, profileContent);
    });
  }

  if (btnCancelProfile) {
    btnCancelProfile.addEventListener('click', () => {
      if (inputProfileName && inputProfileName.value !== currentUser.name) {
        if (!confirm('Discard unsaved profile changes?')) return;
      }
      if (inputProfileName) inputProfileName.value = currentUser.name;
      if (inputProfileEmail) inputProfileEmail.value = currentUser.email;
      if (inputProfilePhone) inputProfilePhone.value = currentUser.phone;
      if (inputProfileBio) inputProfileBio.value = currentUser.bio;
      hideModal(profileModal, profileContent);
    });
  }

  // Addresses Actions
  const btnShowAddAddress = document.getElementById('btn-show-add-address');
  const addrForm = document.getElementById('addr-form-container');
  const btnCancelAddrForm = document.getElementById('btn-cancel-addr-form');
  const btnSaveAddrAction = document.getElementById('btn-save-addr-action');
  const btnUseLocation = document.getElementById('btn-use-location');
  const locationAlert = document.getElementById('location-alert');

  if (btnShowAddAddress && addrForm) {
    btnShowAddAddress.addEventListener('click', () => {
      addrForm.classList.remove('hidden');
    });
  }
  if (btnCancelAddrForm && addrForm) {
    btnCancelAddrForm.addEventListener('click', () => {
      addrForm.classList.add('hidden');
    });
  }
  if (btnUseLocation && locationAlert) {
    btnUseLocation.addEventListener('click', () => {
      locationAlert.classList.remove('hidden');
      locationAlert.textContent = 'GPS location pinned: Lekki Phase 1, Victoria Island Corridor, Lagos. (Manage permissions in browser/device settings).';
      const street = document.getElementById('input-addr-street');
      const city = document.getElementById('input-addr-city');
      const state = document.getElementById('input-addr-state');
      if (street) street.value = '18 Admiralty Way';
      if (city) city.value = 'Lekki';
      if (state) state.value = 'Lagos';
    });
  }
  if (btnSaveAddrAction && addrForm) {
    btnSaveAddrAction.addEventListener('click', () => {
      const street = document.getElementById('input-addr-street');
      const title = document.getElementById('input-addr-title');
      if (!street || !street.value) {
        alert('Please enter street address');
        return;
      }
      const container = document.getElementById('address-list-container');
      if (container) {
        const card = document.createElement('div');
        card.className = 'p-3 rounded-2xl border border-slate-200 bg-white relative flex flex-col justify-between address-card';
        card.innerHTML = `<div class="flex justify-between items-start mb-1"><span class="text-xs font-bold text-slate-900">${title && title.value ? title.value : 'New Address'}</span><button class="text-[10px] text-rose-500 font-semibold btn-del-addr">Delete</button></div><p class="text-xs text-slate-700 font-medium">${currentUser.name} • ${currentUser.phone}</p><p class="text-[11px] text-slate-500 mt-0.5">${street.value}</p>`;
        container.appendChild(card);
        const del = card.querySelector('.btn-del-addr');
        if (del) del.addEventListener('click', () => card.remove());
      }
      addrForm.classList.add('hidden');
    });
  }

  // 2. My Wallet Handler
  if (menuWallet) {
    menuWallet.addEventListener('click', () => {
      closeDrawer();
      showModal(walletModal, walletContent);
    });
  }
  if (btnCloseWallet) {
    btnCloseWallet.addEventListener('click', () => hideModal(walletModal, walletContent));
  }
  if (walletModal) {
    walletModal.addEventListener('click', (e) => {
      if (e.target === walletModal) hideModal(walletModal, walletContent);
    });
  }

  const btnWalletTopup = document.getElementById('btn-wallet-topup');
  const walletBalanceDisplay = document.getElementById('wallet-view-balance');
  const drawerWalletDisplay = document.getElementById('drawer-menu-wallet-val');
  if (btnWalletTopup) {
    btnWalletTopup.addEventListener('click', () => {
      currentUser.wallet += 25000;
      const formatted = '₦' + currentUser.wallet.toLocaleString();
      if (walletBalanceDisplay) walletBalanceDisplay.textContent = formatted;
      if (drawerWalletDisplay) drawerWalletDisplay.textContent = formatted;
      alert('₦25,000 added to your Sleec Wallet!');
    });
  }

  // 3. Help & Support Handler
  if (menuSupport) {
    menuSupport.addEventListener('click', () => {
      closeDrawer();
      showModal(supportModal, supportContent);
    });
  }
  if (btnCloseSupport) {
    btnCloseSupport.addEventListener('click', () => hideModal(supportModal, supportContent));
  }
  if (supportModal) {
    supportModal.addEventListener('click', (e) => {
      if (e.target === supportModal) hideModal(supportModal, supportContent);
    });
  }

  // Accordions
  const faqToggles = document.querySelectorAll('.btn-faq-toggle');
  faqToggles.forEach(btn => {
    btn.addEventListener('click', () => {
      const content = btn.parentElement.querySelector('.faq-content');
      const icon = btn.querySelector('.faq-icon');
      if (content) {
        const isHidden = content.classList.contains('hidden');
        content.classList.toggle('hidden', !isHidden);
        if (icon) icon.textContent = isHidden ? '−' : '+';
      }
    });
  });

  // FAQ Search filter
  const faqInput = document.getElementById('input-faq-search');
  if (faqInput) {
    faqInput.addEventListener('input', (e) => {
      const val = e.target.value.toLowerCase();
      const items = document.querySelectorAll('.faq-item');
      items.forEach(item => {
        const text = item.textContent.toLowerCase();
        item.style.display = text.includes(val) ? '' : 'none';
      });
    });
  }

  // Support form submission
  const supportForm = document.getElementById('form-support-message');
  const supportToast = document.getElementById('support-toast');
  if (supportForm && supportToast) {
    supportForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = document.getElementById('support-message-text');
      if (msg && !msg.value.trim()) {
        alert('Please enter a message description.');
        return;
      }
      supportToast.classList.remove('hidden');
      setTimeout(() => {
        supportToast.classList.add('hidden');
        if (msg) msg.value = '';
      }, 3500);
    });
  }

  // 4. Log Out Flow
  if (menuLogout) {
    menuLogout.addEventListener('click', () => {
      closeDrawer();
      if (logoutDialog && logoutContent) {
        logoutDialog.classList.remove('opacity-0', 'pointer-events-none');
        logoutDialog.classList.add('opacity-100', 'pointer-events-auto');
        logoutContent.classList.remove('scale-95');
        logoutContent.classList.add('scale-100');
      }
    });
  }

  function closeLogoutDialog() {
    if (logoutDialog && logoutContent) {
      logoutDialog.classList.remove('opacity-100', 'pointer-events-auto');
      logoutDialog.classList.add('opacity-0', 'pointer-events-none');
      logoutContent.classList.remove('scale-100');
      logoutContent.classList.add('scale-95');
    }
  }

  if (btnLogoutCancel) btnLogoutCancel.addEventListener('click', closeLogoutDialog);
  if (logoutDialog) {
    logoutDialog.addEventListener('click', (e) => {
      if (e.target === logoutDialog) closeLogoutDialog();
    });
  }

  if (btnLogoutConfirm) {
    btnLogoutConfirm.addEventListener('click', () => {
      currentUser.isLoggedIn = false;
      closeLogoutDialog();

      // Transition UI to Guest state
      if (greetingTitle) {
        greetingTitle.textContent = 'Hey there, ready to discover fresh drops?';
      }
      if (drawerDisplayName) drawerDisplayName.textContent = 'Guest User';
      if (drawerDisplayEmail) drawerDisplayEmail.textContent = 'Sign in to access your wallet';
      const badge = document.getElementById('drawer-badge-pill');
      if (badge) {
        badge.textContent = 'Sign In / Register';
        badge.className = 'inline-block px-2 py-0.5 rounded-full bg-white/20 text-white text-[10px] font-semibold mt-1 cursor-pointer';
      }
      if (drawerWalletDisplay) drawerWalletDisplay.textContent = 'Sign in to view';
      const menuLabel = document.getElementById('menu-logout-label');
      if (menuLabel) menuLabel.textContent = 'Sign In';
    });
  }
})();
</script>
