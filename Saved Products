    },
    {
      id: "prod-4",
      category: "apparel",
      brand: "Studio Optic",
      name: "Tortoise Classic",
      rating: "4.7",
      variant: "Handcrafted",
      stock: "In Stock",
      stockClass: "text-emerald-700",
      price: "₦16,000",
      img: "https://lh3.googleusercontent.com/aida-public/AB6AXuDpk5Mg8hRvB6K5-_fPgzKTaI5bdIFbSwZAWcXNphe4ZMRkhIY_r_GbUhImb3sVhD7_7k0pzn62rDaiBJqvfTodBU9zqySk1VNU0dNq8G0iQ2a4J9TSzfQzb9ZW4WPFn9CBMA6EXY7viVyUBvQ44aX4ouOcv4Kore_4aM4SYFujQxk2AO8RsUnXa0vaMVbnYkq8JuByqa5Kg7Jr-geh1rdv5Lk_2uK1ypXIPVhxycYkWwPNRezjd48"
    }
  ];

  let savedProducts = [...initialProducts];
  let currentView = localStorage.getItem('sleec_saved_view') || 'grid'; // 'grid' | 'list'
  let currentCategory = 'all';
  let cartCount = 3;
  let lastRemovedItem = null;
  let lastRemovedIndex = -1;
  let toastTimer = null;

  // DOM elements
  const productsMount = document.getElementById('productsMount');
  const emptyState = document.getElementById('emptyState');
  const gridViewBtn = document.getElementById('gridViewBtn');
  const listViewBtn = document.getElementById('listViewBtn');
  const itemCountBadge = document.getElementById('itemCountBadge');
  const cartBadge = document.getElementById('cartBadge');
  const toast = document.getElementById('toast');
  const toastMsg = document.getElementById('toastMsg');
  const toastUndoBtn = document.getElementById('toastUndoBtn');
  const filterPills = document.querySelectorAll('.filter-pill');
  const totalCountLabels = document.querySelectorAll('.total-count-label');

  function updateViewToggleButtons() {
    if (currentView === 'grid') {
      gridViewBtn.className = 'p-1.5 rounded-lg bg-[#0c2e1f] text-white transition-all shadow-sm';
      listViewBtn.className = 'p-1.5 rounded-lg text-white/80 hover:text-white transition-all';
    } else {
      listViewBtn.className = 'p-1.5 rounded-lg bg-[#0c2e1f] text-white transition-all shadow-sm';
      gridViewBtn.className = 'p-1.5 rounded-lg text-white/80 hover:text-white transition-all';
    }
  }

  function renderProducts() {
    const filtered = currentCategory === 'all' 
      ? savedProducts 
      : savedProducts.filter(item => item.category === currentCategory);

    // Update count badges
    const totalCount = savedProducts.length;
    const currentCount = filtered.length;
    itemCountBadge.textContent = `${currentCount} item${currentCount === 1 ? '' : 's'}`;
    totalCountLabels.forEach(lbl => lbl.textContent = totalCount);

    if (filtered.length === 0) {
      productsMount.innerHTML = '';
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');

    if (currentView === 'grid') {
      productsMount.innerHTML = `
        <div class="grid grid-cols-2 gap-3.5 animate-fadeIn">
          ${filtered.map(item => `
            <article data-id="${item.id}" class="bg-white rounded-3xl p-2.5 shadow-soft border border-slate-100 flex flex-col justify-between relative group hover:shadow-float transition-all">
              <div>
                <!-- Image Frame -->
                <div class="relative w-full aspect-square rounded-2xl overflow-hidden bg-slate-100">
                  <img alt="${item.name}" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300" src="${item.img}"/>
                  <!-- Rating Badge -->
                  <div class="absolute top-2 left-2 bg-white/90 backdrop-blur-md px-1.5 py-0.5 rounded-full flex items-center gap-1 shadow-sm">
                    <svg class="w-3 h-3 text-amber-500 fill-amber-500" viewbox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                    <span class="text-[10px] font-bold text-slate-800 leading-none">${item.rating}</span>
                  </div>
                  <!-- Saved Bookmark Heart (Active) -->
                  <button data-action="unsave" data-id="${item.id}" aria-label="Remove from saved" class="absolute top-2 right-2 w-7 h-7 rounded-full bg-white/95 backdrop-blur-md flex items-center justify-center text-emerald-700 shadow-sm active:scale-90 transition-transform" type="button">
                    <svg class="w-4 h-4 fill-[#1b4332] text-[#1b4332]" viewbox="0 0 24 24">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                    </svg>
                  </button>
                </div>
                <!-- Content Info -->
                <div class="mt-2.5 px-1">
                  <span class="text-[11px] font-medium text-slate-400 block tracking-tight">${item.brand}</span>
                  <h2 class="text-sm font-semibold text-slate-900 truncate leading-snug">${item.name}</h2>
                  <div class="flex items-center gap-1.5 mt-1">
                    <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">${item.variant}</span>
                    <span class="text-[10px] font-medium ${item.stockClass}">${item.stock}</span>
                  </div>
                </div>
              </div>
              <!-- Bottom Price & Cart Action -->
              <div class="mt-3 px-1 flex items-center justify-between">
                <span class="text-sm font-bold text-slate-900 tracking-tight">${item.price}</span>
                <button data-action="add-cart" data-name="${item.name}" aria-label="Add ${item.name} to Cart" class="w-8 h-8 rounded-full bg-[#1b4332] text-white flex items-center justify-center shadow-sm active:scale-95 transition-transform" type="button">
                  <svg class="w-4 h-4 stroke-[2.2]" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                    <path d="M12 4.5v15m7.5-7.5h-15" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>
              </div>
            </article>
          `).join('')}
        </div>
      `;
    } else {
      // List View: horizontal cards
      productsMount.innerHTML = `
        <div class="flex flex-col gap-3 animate-fadeIn">
          ${filtered.map(item => `
            <article data-id="${item.id}" class="bg-white rounded-2xl p-3 shadow-soft border border-slate-100 flex items-center gap-3.5 relative group hover:shadow-float transition-all">
              <!-- Thumbnail Frame with rating badge -->
              <div class="relative w-24 h-24 rounded-xl overflow-hidden bg-slate-100 shrink-0">
                <img alt="${item.name}" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300" src="${item.img}"/>
                <div class="absolute top-1.5 left-1.5 bg-white/95 backdrop-blur-md px-1.5 py-0.5 rounded-full flex items-center gap-1 shadow-xs">
                  <svg class="w-2.5 h-2.5 text-amber-500 fill-amber-500" viewbox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                  </svg>
                  <span class="text-[9px] font-bold text-slate-800 leading-none">${item.rating}</span>
                </div>
              </div>
              
              <!-- Content Info -->
              <div class="flex-1 min-w-0 pr-1">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <span class="text-[11px] font-medium text-slate-400 block tracking-tight truncate">${item.brand}</span>
                    <h2 class="text-sm font-semibold text-slate-900 truncate leading-snug">${item.name}</h2>
                  </div>
                  <!-- Saved Heart Icon -->
                  <button data-action="unsave" data-id="${item.id}" aria-label="Remove from saved" class="w-7 h-7 rounded-full bg-slate-50 flex items-center justify-center text-emerald-700 shadow-2xs shrink-0 active:scale-90 transition-transform" type="button">
                    <svg class="w-4 h-4 fill-[#1b4332] text-[#1b4332]" viewbox="0 0 24 24">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                    </svg>
                  </button>
                </div>
                
                <div class="flex items-center gap-1.5 mt-1.5">
                  <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">${item.variant}</span>
                  <span class="text-[10px] font-medium ${item.stockClass}">${item.stock}</span>
                </div>

                <div class="mt-2.5 flex items-center justify-between">
                  <span class="text-sm font-bold text-slate-900 tracking-tight">${item.price}</span>
                  <button data-action="add-cart" data-name="${item.name}" aria-label="Add ${item.name} to Cart" class="px-2.5 py-1.5 rounded-full bg-[#1b4332] text-white flex items-center gap-1 shadow-sm active:scale-95 transition-transform text-[11px] font-semibold" type="button">
                    <svg class="w-3.5 h-3.5 stroke-[2.2]" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                      <path d="M12 4.5v15m7.5-7.5h-15" stroke-linecap="round" stroke-linejoin="round"></path>
