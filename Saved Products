              </div>
            </article>
          `).join('')}
        </div>
      `;
    }
  }

  function showToast(message, allowUndo = true) {
    if (toastTimer) clearTimeout(toastTimer);
    toastMsg.textContent = message;
    toastUndoBtn.style.display = allowUndo ? 'inline-block' : 'none';
    toast.classList.remove('opacity-0', 'translate-y-[-10px]', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0');

    toastTimer = setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-[-10px]', 'pointer-events-none');
      toast.classList.remove('opacity-100', 'translate-y-0');
    }, 3200);
  }

  // Toggle View Click Listeners
  gridViewBtn.addEventListener('click', () => {
    if (currentView === 'grid') return;
    currentView = 'grid';
    localStorage.setItem('sleec_saved_view', 'grid');
    updateViewToggleButtons();
    renderProducts();
  });

  listViewBtn.addEventListener('click', () => {
    if (currentView === 'list') return;
    currentView = 'list';
    localStorage.setItem('sleec_saved_view', 'list');
    updateViewToggleButtons();
    renderProducts();
  });

  // Filter Pills Handler
  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => {
        p.className = 'filter-pill px-4 py-2 bg-white/95 text-slate-700 hover:text-[#0c2e1f] text-xs font-medium rounded-full shadow-sm border border-emerald-900/10 whitespace-nowrap active:scale-95 transition-all';
      });
      pill.className = 'filter-pill px-4 py-2 bg-[#0c2e1f] text-white text-xs font-semibold rounded-full shadow-md whitespace-nowrap active:scale-95 transition-all';
      currentCategory = pill.dataset.cat;
      renderProducts();
    });
  });

  // Product card delegation: Unsave & Add-to-cart
  productsMount.addEventListener('click', (e) => {
    const unsaveBtn = e.target.closest('button[data-action="unsave"]');
    if (unsaveBtn) {
      const id = unsaveBtn.dataset.id;
      const index = savedProducts.findIndex(p => p.id === id);
      if (index !== -1) {
        lastRemovedItem = savedProducts[index];
        lastRemovedIndex = index;
        savedProducts.splice(index, 1);
        renderProducts();
        showToast(`${lastRemovedItem.name} removed`, true);
      }
      return;
    }

    const cartBtn = e.target.closest('button[data-action="add-cart"]');
    if (cartBtn) {
      cartCount++;
      cartBadge.textContent = cartCount;
      cartBadge.classList.add('scale-125');
      setTimeout(() => cartBadge.classList.remove('scale-125'), 200);
      const name = cartBtn.dataset.name;
      showToast(`${name} added to Bag`, false);
    }
  });

  // Undo button click
  toastUndoBtn.addEventListener('click', () => {
    if (lastRemovedItem) {
      savedProducts.splice(lastRemovedIndex, 0, lastRemovedItem);
      renderProducts();
      showToast(`${lastRemovedItem.name} restored`, false);
      lastRemovedItem = null;
      lastRemovedIndex = -1;
    }
  });

  // Initialize
  updateViewToggleButtons();
  renderProducts();
})();
</script>


