  // Close all modal sheets smoothly
  function closeAllModals() {
    document.querySelectorAll('.sheet-modal').forEach(modal => {
      modal.classList.add('opacity-0', 'pointer-events-none');
    });
    document.querySelectorAll('.sheet-panel').forEach(panel => {
      panel.classList.add('translate-y-full');
    });
  }

  // Filter & Search Engine
  function applyFilters() {
    let visibleCount = 0;
    const query = searchQuery.trim().toLowerCase();

    orderCards.forEach(card => {
      const cardStatus = card.dataset.status;
      const searchData = (card.dataset.search || '').toLowerCase();

      const matchesStatus = (currentFilter === 'all') || (cardStatus === currentFilter);
      const matchesQuery = query === '' || searchData.includes(query);

      if (matchesStatus && matchesQuery) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (countLabel) {
      countLabel.textContent = `${visibleCount} Order${visibleCount === 1 ? '' : 's'} Found`;
    }

    if (visibleCount === 0) {
      if (emptyState) {
        emptyState.classList.remove('hidden');
        emptyState.classList.add('flex');
      }
      if (ordersListContainer) ordersListContainer.classList.add('hidden');
    } else {
      if (emptyState) {
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');
      }
      if (ordersListContainer) ordersListContainer.classList.remove('hidden');
    }
  }

  // DOMContentLoaded initialization
  window.addEventListener('DOMContentLoaded', () => {
    searchInput = document.getElementById('order-search-input');
    clearSearchBtn = document.getElementById('clear-search-btn');
    filterChips = document.querySelectorAll('.filter-chip');
    orderCards = document.querySelectorAll('.order-card');
    emptyState = document.getElementById('empty-state');
    ordersListContainer = document.getElementById('orders-list-container');
    countLabel = document.getElementById('active-results-count');
    resetFiltersBtn = document.getElementById('reset-filters-btn');

    // Filter Chips Event Listener
    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filterChips.forEach(c => {
          c.classList.remove('bg-[#0c2e1f]', 'text-white', 'shadow-sm');
          c.classList.add('bg-white', 'text-stone-600');
        });
        chip.classList.add('bg-[#0c2e1f]', 'text-white', 'shadow-sm');
        chip.classList.remove('bg-white', 'text-stone-600');

        currentFilter = chip.dataset.filter;
        applyFilters();
      });
    });

    // Search Input Event Listener
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        if (searchQuery.length > 0) {
          clearSearchBtn?.classList.remove('hidden');
        } else {
          clearSearchBtn?.classList.add('hidden');
        }
        applyFilters();
      });
    }

    // Clear Search Button
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn.classList.add('hidden');
        applyFilters();
        searchInput.focus();
      });
    }

    // Reset Filters in Empty State
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn?.classList.add('hidden');
        const allChip = document.querySelector('[data-filter="all"]');
        if (allChip) allChip.click();
      });
    }

    // Card Body Click Listener to open respective detail views
    orderCards.forEach(card => {
      card.addEventListener('click', () => {
        const id = card.dataset.orderId;
        if (id === 'SLC-84920') {
          openTrackingModal();
        } else if (id === 'SLC-79114') {
          openPickupModal();
        } else if (id === 'SLC-65201' || id === 'SLC-58210') {
          openOrderDetailsModal(id);
        }
      });
    });

    // Dismiss modals when clicking backdrop
    document.querySelectorAll('.sheet-modal').forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeAllModals();
        }
      });
    });
  });
</script>
<!-- END: Consolidated Vanilla JS -->
