      const distanceToBottom = viewChat.scrollHeight - viewChat.scrollTop - viewChat.clientHeight;
      if (force || distanceToBottom < 280) {
        viewChat.scrollTo({
          top: viewChat.scrollHeight + 100,
          behavior: 'smooth'
        });
        wrapScrollLatest.classList.add('hidden');
      } else {
        wrapScrollLatest.classList.remove('hidden');
      }
    }, 60);
