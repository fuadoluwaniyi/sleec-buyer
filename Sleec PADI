    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    touch-action: pan-y;
    overscroll-behavior-y: contain;
    pointer-events: auto;
  }
  .drawer-transition { transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease; }
