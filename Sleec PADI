  .app-viewport {
    width: 100%;
    max-width: 440px;
    height: 956px;
    min-height: 956px;
    max-height: 956px;
    position: relative;
    overflow-x: hidden;
    overflow-y: hidden;
    margin: 0 auto;
    background: linear-gradient(180deg, #EAF7F0 0%, #F5FAF6 45%, #EDF7F1 100%);
