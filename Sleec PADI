    if (lower.includes("bag") || lower.includes("cart") || lower.includes("checkout")) {
      return {
        text: "Here is your current bag overview. You have items waiting from verified merchants:",
        productIds: state.cart.map(c => c.id),
        shopId: null,
        quickReplies: ['Open My Bag', 'Checkout with Sleec Pay', 'Continue Shopping']
      };
    }

    // 9. TRENDING DROPS
    if (lower.includes("trending") || lower.includes("drop") || lower.includes("popular") || lower.includes("hot")) {
      return {
        text: "🔥 **Trending Drops This Week**\nCurated items hand-picked by our editors from verified creators:",
        productIds: ['prod_1', 'prod_2', 'prod_5'],
        shopId: null,
        quickReplies: ['View Stride Runners', 'Find a Shop', 'Check Bag']
      };
    }

    // 10. GREETINGS
    if (/^(hi|hello|hey|yo|padi|good morning|good afternoon)\b/i.test(lower)) {
      return {
        text: "Hey! 👋 I’m Padi, your Sleec shopping assistant. What would you like to explore today?",
        productIds: ['prod_1', 'prod_3'],
        shopId: null,
        quickReplies: ['Trending Drops', 'Track My Order', 'Find a Shop', 'Create a Shop']
      };
    }

    // 11. FRIENDLY FALLBACK WITH HELPFUL ACTIONS
    return {
      text: `I'm not completely sure about "${q}", but I'm learning every day! 🐻\n\nI can help you find products, discover verified shops, track your orders, check nationwide delivery, or answer questions about shopping on Sleec.`,
      productIds: ['prod_1', 'prod_3'],
      shopId: null,
      quickReplies: ['Trending Drops', 'Track Order', 'Find Sneakers', 'Create a Shop']
    };
  }

  // HANDLE USER SEND
  function handleSend(overrideText = null) {
    const q = (overrideText !== null ? overrideText : chatInput.value).trim();
    if (!q && !state.attachedFile) return;

    chatInput.value = '';
    state.attachedFile = null;
    attachmentPreview.classList.add('hidden');

    appendUserBubble(q || 'Photo uploaded');

    typingIndicator.classList.remove('hidden');
    smartScrollToBottom(true);

    setTimeout(() => {
      typingIndicator.classList.add('hidden');
      const response = processPadiResponse(q);
      renderPadiBubble(response.text, response.productIds, response.shopId, response.quickReplies, response.orderCard);
    }, 420);
  }

  btnSend.addEventListener('click', () => handleSend());
  chatInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') handleSend(); });

  // HOME QUICK ACTION BUTTONS
  homeQuickActions.addEventListener('click', (e) => {
    const chip = e.target.closest('.quick-chip-btn');
    if (chip) {
      handleSend(chip.dataset.q);
    }
  });

  // DELEGATED INTERACTION HANDLERS
  document.addEventListener('click', (e) => {
    // Quick replies in chat
    const qr = e.target.closest('.qr-btn');
    if (qr) {
      const val = qr.dataset.qr;
      if (val === 'Visit Storefront') {
        openStorefrontModal('shop_soundwave');
      } else if (val === 'Open My Bag' || val === 'Check Bag') {
        updateCartUI();
        modalCart.classList.remove('hidden');
      } else if (val === 'Checkout Now' || val === 'Checkout with Sleec Pay') {
        modalCart.classList.remove('hidden');
      } else if (val === 'View Stride Runners') {
        openProductModal('prod_1');
      } else if (val === 'View Fragrance') {
        openProductModal('prod_3');
      } else if (val === 'View Nocturne Hoodie') {
        openProductModal('prod_5');
      } else if (val === 'Check Size 42') {
        openProductModal('prod_1');
      } else if (val === 'Add Both to Bag') {
        state.cart.push({ id: 'prod_1', size: '42', qty: 1 }, { id: 'prod_2', size: 'One Size', qty: 1 });
        updateCartUI();
        showToast('Added Stride Runners & Tote to Bag! 🛍️', '🛍️');
      } else if (val.includes('Launch Storefront') || val.includes('Create a Shop')) {
        openCreateShopModal();
      } else if (val === 'Contact Courier' || val === 'Call Courier') {
        showToast('Calling Courier Tunde Adebayo...', '📞');
      } else if (val === 'Live GPS Map' || val === 'Live GPS') {
        showToast('Courier is 1.8km away (Ring Road)', '📍');
      } else {
        handleSend(val);
      }
      return;
    }

    // Call / GPS actions in order card
    const actBtn = e.target.closest('[data-action]');
    if (actBtn) {
      const act = actBtn.dataset.action;
      if (act === 'call-rider') {
        showToast(`Dialing ${ORDER_DATA.rider}...`, '📞');
      } else if (act === 'track-map') {
        showToast('Live GPS: Courier 12 mins away', '📍');
      }
      return;
    }

    // Open Shop from card
    const openSf = e.target.closest('[data-open-shop]');
    if (openSf) {
      openStorefrontModal(openSf.dataset.openShop);
      return;
    }

    // Shop in-stock products
    const spProds = e.target.closest('[data-shop-prods]');
    if (spProds) {
      const s = SHOPS[spProds.dataset.shopProds];
      if (s) renderPadiBubble(`Here are in-stock items currently available at **${s.name}**:`, s.productIds, null, ['Visit Storefront', 'Check Bag']);
      return;
    }

    // View product details
    const vp = e.target.closest('[data-view-p]');
    if (vp) {
      openProductModal(vp.dataset.viewP);
      return;
    }

    // Quick add to bag
    const qb = e.target.closest('[data-quick-bag]');
    if (qb) {
      const pid = qb.dataset.quickBag;
      const p = CATALOGUE[pid];
      if (p) {
        state.cart.push({ id: pid, size: p.sizes[0], qty: 1 });
        updateCartUI();
        showToast(`Added ${p.name} to Bag!`, '🛍️');
      }
      return;
    }
  });

  // STOREFRONT MODAL
  function openStorefrontModal(shopId) {
    const s = SHOPS[shopId] || SHOPS.shop_soundwave;
    document.getElementById('sf-name').textContent = s.name;
    document.getElementById('sf-avatar').textContent = s.emoji;
    document.getElementById('sf-banner').src = s.banner;
    document.getElementById('sf-rating').textContent = s.rating + ' • Nationwide';
    document.getElementById('sf-desc').textContent = s.desc;
    document.getElementById('sf-delivery').textContent = `📍 ${s.delivery}`;

    const list = document.getElementById('sf-products');
    list.innerHTML = '';
    s.productIds.forEach(pid => {
      const p = CATALOGUE[pid];
      if (!p) return;
      const card = document.createElement('div');
      card.className = 'bg-neutral-50 rounded-2xl p-2.5 border border-neutral-100 flex flex-col justify-between';
      card.innerHTML = `
        <div class="h-24 rounded-xl overflow-hidden bg-neutral-200 mb-2 cursor-pointer" data-view-p="${p.id}">
          <img src="${p.image}" class="w-full h-full object-cover" alt="${p.name}">
        </div>
        <h5 class="text-xs font-bold text-neutral-800 truncate">${p.name}</h5>
        <span class="text-xs font-extrabold text-[#0F382A] mt-0.5 block">${formatNaira(p.price)}</span>
        <button data-view-p="${p.id}" class="w-full mt-2 py-1.5 bg-emerald-600 text-white font-bold text-[10px] rounded-xl active:scale-95 transition">View &amp; Buy</button>
      `;
      list.appendChild(card);
    });
    modalStorefront.classList.remove('hidden');
  }

  btnCloseStorefront.addEventListener('click', () => modalStorefront.classList.add('hidden'));
  modalStorefront.addEventListener('click', (e) => {
    if (e.target === modalStorefront) modalStorefront.classList.add('hidden');
  });

  // PRODUCT MODAL
  function openProductModal(pid) {
    const p = CATALOGUE[pid];
    if (!p) return;
    state.activeProdInSheet = p;
    state.selectedSize = p.sizes[0];

    document.getElementById('ps-seller').textContent = p.seller;
    document.getElementById('ps-title').textContent = p.name;
    document.getElementById('ps-image').src = p.image;
    document.getElementById('ps-price').textContent = formatNaira(p.price);
    document.getElementById('ps-original').textContent = formatNaira(p.originalPrice);
    document.getElementById('ps-desc').textContent = p.description;
    document.getElementById('ps-btn-price').textContent = `• ${formatNaira(p.price)}`;

    const szBox = document.getElementById('ps-sizes');
    szBox.innerHTML = '';
    p.sizes.forEach((s, idx) => {
      const b = document.createElement('button');
      b.className = `px-3 py-1.5 rounded-xl text-xs font-bold border transition ${idx === 0 ? 'bg-[#0F382A] text-white border-[#0F382A]' : 'bg-neutral-50 text-neutral-700 border-neutral-200'}`;
      b.textContent = s;
      b.onclick = () => {
        state.selectedSize = s;
        szBox.querySelectorAll('button').forEach(btn => btn.className = 'px-3 py-1.5 rounded-xl text-xs font-bold border bg-neutral-50 text-neutral-700 border-neutral-200');
        b.className = 'px-3 py-1.5 rounded-xl text-xs font-bold border bg-[#0F382A] text-white border-[#0F382A]';
      };
      szBox.appendChild(b);
    });

    modalProduct.classList.remove('hidden');
  }

  btnCloseProduct.addEventListener('click', () => modalProduct.classList.add('hidden'));
  modalProduct.addEventListener('click', (e) => {
    if (e.target === modalProduct) modalProduct.classList.add('hidden');
  });

  document.getElementById('ps-add-bag').addEventListener('click', () => {
    const p = state.activeProdInSheet;
    if (!p) return;
    state.cart.push({ id: p.id, size: state.selectedSize || p.sizes[0], qty: 1 });
    updateCartUI();
    modalProduct.classList.add('hidden');
    showToast(`Added ${p.name} to Bag!`, '🛍️');
  });

  document.getElementById('ps-wishlist').addEventListener('click', () => {
    showToast('Saved to your wishlist ❤️', '❤️');
  });

  // CART MODAL
  btnOpenBag.addEventListener('click', () => {
    updateCartUI();
    modalCart.classList.remove('hidden');
  });
  btnCloseCart.addEventListener('click', () => modalCart.classList.add('hidden'));
  modalCart.addEventListener('click', (e) => {
    if (e.target === modalCart) modalCart.classList.add('hidden');
  });
  document.getElementById('btn-checkout').addEventListener('click', () => {
    if (state.cart.length === 0) {
      showToast('Your bag is currently empty', '🛍️');
      return;
    }
    modalCart.classList.add('hidden');
    state.cart = [];
    updateCartUI();
    showToast('Order confirmed via Sleec Pay! 🎉', '💳');
    renderPadiBubble("🎉 **Payment Confirmed!** Your order has been placed into secure Sleec Escrow. The verified merchants have been notified to package and dispatch. Track the live stages anytime right here in Padi.", [], null, ['Track Order Status', 'Discover More Drops']);
  });

  // ATTACHMENT, CAMERA & VOICE
  btnAttach.addEventListener('click', () => filePicker.click());
  filePicker.addEventListener('change', (e) => {
    const f = e.target.files[0];
    if (f) {
      state.attachedFile = f;
      attachmentThumb.src = URL.createObjectURL(f);
      attachmentName.textContent = f.name;
      attachmentPreview.classList.remove('hidden');
    }
  });
  btnRemoveAttachment.addEventListener('click', () => {
    state.attachedFile = null;
    attachmentPreview.classList.add('hidden');
  });

  btnCamera.addEventListener('click', () => modalCamera.classList.remove('hidden'));
  btnCloseCamera.addEventListener('click', () => modalCamera.classList.add('hidden'));
  btnSnapPhoto.addEventListener('click', () => {
    modalCamera.classList.add('hidden');
    attachmentThumb.src = 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&auto=format&fit=crop&q=80';
    attachmentName.textContent = 'visual_search.jpg';
    attachmentPreview.classList.remove('hidden');
    showToast('Item photo captured!', '📸');
    handleSend('Find matches for this item');
  });

  btnVoice.addEventListener('click', () => voiceBar.classList.remove('hidden'));
  btnCancelVoice.addEventListener('click', () => voiceBar.classList.add('hidden'));
  btnDoneVoice.addEventListener('click', () => {
    voiceBar.classList.add('hidden');
    chatInput.value = 'Show me trending running shoes';
    showToast('Voice transcribed ✨', '🎙️');
    handleSend();
  });

  // SCROLL DETECTION FOR "LATEST MESSAGE" PILL
  viewChat.addEventListener('scroll', () => {
    const dist = viewChat.scrollHeight - viewChat.scrollTop - viewChat.clientHeight;
    if (dist > 90) {
      wrapScrollLatest.classList.remove('hidden');
    } else {
      wrapScrollLatest.classList.add('hidden');
    }
  }, { passive: true });

  btnScrollLatest.addEventListener('click', () => {
    viewChat.scrollTo({ top: viewChat.scrollHeight, behavior: 'smooth' });
    wrapScrollLatest.classList.add('hidden');
  });

  // BOTTOM NAVIGATION TABS
  document.querySelectorAll('.nav-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const t = tab.dataset.tab;
      if (t === 'ai') {
        if (state.currentView === 'chat') {
          showToast('In Padi Chat session', '✨');
        } else {
          showToast('Padi is ready', '🌱');
        }
      } else if (t === 'home') {
        startNewChat();
      } else if (t === 'orders') {
        handleSend('Track my active order');
      } else if (t === 'discover') {
        handleSend('Show me trending drops');
      } else if (t === 'saved') {
        showToast('Viewing Saved Items (4 items)', '❤️');
      }
    });
  });

  // INITIAL SETUP
  updateCartUI();
});
</script>
</body></html>
