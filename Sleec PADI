  // COMPREHENSIVE CONVERSATIONAL AI & INTENT UNDERSTANDING ENGINE
  function processPadiResponse(query) {
    const q = query.trim();
    const lower = q.toLowerCase();

    // 1. IDENTITY & WHO ARE YOU / WHAT CAN YOU DO
    if (
      lower.includes("who are you") ||
      lower.includes("tell me about yourself") ||
      lower.includes("what can you do") ||
      lower.includes("are you an ai") ||
      lower.includes("what is padi") ||
      lower.includes("help")
    ) {
      return {
        text: "I'm **Padi**, your Sleec shopping companion! 🐻✨\n\nI'm here to help you discover fresh drops, find verified independent shops, track orders and deliveries in real time, recommend styles that match your vibe, and navigate everything on Sleec seamlessly.",
        productIds: [],
        shopId: null,
        quickReplies: ['Find Sneakers', 'Track an Order', 'How Sleec Works', 'Create a Shop']
      };
    }

    // 2. SLEEC PLATFORM QUESTIONS & HOW IT WORKS
    if (
      lower.includes("what is sleec") ||
      lower.includes("how does sleec work") ||
      lower.includes("what can i buy") ||
      lower.includes("delivery cost") ||
      lower.includes("sleec delivery") ||
      lower.includes("how does delivery work")
    ) {
      return {
        text: "✨ **Welcome to Sleec!**\nSleec is Nigeria's curated social shopping platform connecting you with verified independent fashion brands, sneaker creators, and boutique shops.\n\n• **Buyer Protection:** Escrow payment stays secure until you receive and verify items.\n• **Sleec Express:** Fast, reliable tracked delivery across Lagos, Abuja, Ilorin, and nationwide.",
        productIds: ['prod_1', 'prod_3'],
        shopId: null,
        quickReplies: ['Trending Drops', 'Track My Order', 'Create a Shop', 'Check Bag']
      };
    }

    // 3. CREATE A SHOP / BECOME A SELLER / OPEN A STORE
    if (
      lower.includes("create a shop") ||
      lower.includes("create my shop") ||
      lower.includes("i want to sell") ||
      lower.includes("become a seller") ||
      lower.includes("open a store") ||
      lower.includes("open a shop") ||
      lower.includes("can i sell") ||
      lower.includes("start selling") ||
      lower.includes("seller onboarding")
    ) {
      return {
        text: "🏪 **Start selling on Sleec in minutes!**\nIndependent brands and verified merchants get instant discovery, automated AI recommendations through Padi, escrow payments, and door-to-door delivery fulfillment across Nigeria.\n\nTap below to launch your storefront:",
        productIds: [],
        shopId: null,
        quickReplies: ['🚀 Launch Storefront Modal', 'How Seller Escrow Works', 'Delivery Rates for Shops']
      };
    }

    // 4. CONTEXTUAL FOLLOW-UPS (Cheaper, Another Shop, Black Color, First item to bag)
    if (
      lower.includes("cheaper") ||
      lower.includes("less expensive") ||
      lower.includes("lower price") ||
      lower.includes("budget option")
    ) {
      state.lastProduct = 'prod_4';
      return {
        text: `Here is our best budget-friendly verified pick under ₦20,000 with standard Sleec delivery warranty:`,
        productIds: ['prod_4', 'prod_2'],
        shopId: null,
        quickReplies: ['Add Tortoise Optics to Bag', 'Show Trending Drops', 'Check Bag']
      };
    }

    if (lower.includes("add the first one") || lower.includes("add first item") || lower.includes("add first to bag")) {
      const targetId = state.lastProduct || 'prod_1';
      const p = CATALOGUE[targetId];
      if (p) {
        state.cart.push({ id: p.id, size: p.sizes[0], qty: 1 });
        updateCartUI();
        showToast(`Added ${p.name} to Bag!`, '🛍️');
        return {
          text: `Done! ✅ Added **${p.name}** (${formatNaira(p.price)}) to your Sleec Bag. Ready to checkout or explore more styles?`,
          productIds: [p.id],
          shopId: null,
          quickReplies: ['Open My Bag', 'Checkout Now', 'Show Matching Hoodie']
        };
      }
