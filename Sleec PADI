  // SWITCH TO ACTIVE CHAT MODE
  function switchToChatMode() {
    state.currentView = 'chat';
    viewHome.classList.add('hidden');
    viewChat.classList.remove('hidden');
    homeQuickActions.classList.add('hidden');
  }

  function loadChatThread(chatId) {
    const thread = chatHistory.find(c => c.id === chatId);
    if (!thread) return;
    state.activeChatId = thread.id;
    switchToChatMode();
    chatMessages.innerHTML = '';

    thread.messages.forEach(msg => {
      if (msg.sender === 'user') {
        appendUserBubble(msg.text, false);
      } else {
        renderPadiBubble(msg.text, msg.productIds || [], msg.shopId || null, msg.quickReplies || [], msg.orderCard || false);
      }
    });
    smartScrollToBottom(true);
  }

  // BUBBLE RENDERING
  function appendUserBubble(text, save = true) {
    switchToChatMode();
    const bubble = document.createElement('div');
    bubble.className = 'flex flex-col items-end self-end max-w-[85%]';
    bubble.innerHTML = `
      <div class="bg-[#0F382A] text-white text-xs leading-relaxed px-4 py-2.5 rounded-2xl rounded-tr-sm shadow-soft font-medium" style="word-break: break-word;">
        ${text}
      </div>
      <span class="text-[9px] text-neutral-400 mt-1 mr-1">Just now</span>
    `;
    chatMessages.appendChild(bubble);
    smartScrollToBottom(true);

    if (save) {
      let active = chatHistory.find(c => c.id === state.activeChatId);
      if (!active) {
        active = {
          id: 'chat_' + Date.now(),
          title: text.length > 25 ? text.substring(0, 22) + '...' : text,
          time: 'Just now',
          messages: []
        };
        chatHistory.unshift(active);
        state.activeChatId = active.id;
      }
      active.messages.push({ sender: 'user', text });
    }
  }

